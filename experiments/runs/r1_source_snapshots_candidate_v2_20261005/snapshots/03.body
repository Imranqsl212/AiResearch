lor-foreground\u0029","var\u0028--sh-token-function\u0029","var\u0028--sh-color-foreground\u0029","var\u0028--sh-token-punctuation\u0029","var\u0028--sh-token-string\u0029","var\u0028--sh-token-punctuation-section\u0029","var\u0028--sh-token-string\u0029","var\u0028--sh-token-punctuation\u0029","var\u0028--sh-token-string\u0029","var\u0028--sh-token-punctuation-section\u0029","var\u0028--sh-token-string\u0029","var\u0028--sh-token-punctuation-section\u0029","var\u0028--sh-token-string\u0029","var\u0028--sh-token-punctuation\u0029","var\u0028--sh-token-string\u0029","var\u0028--sh-token-punctuation-section\u0029","var\u0028--sh-token-string\u0029","var\u0028--sh-token-punctuation-section\u0029","var\u0028--sh-token-string\u0029","var\u0028--sh-token-punctuation\u0029","var\u0028--sh-token-string\u0029","var\u0028--sh-token-punctuation-section\u0029","var\u0028--sh-token-string\u0029","var\u0028--sh-token-punctuation-section\u0029","var\u0028--sh-token-string\u0029","var\u0028--sh-token-punctuation\u0029","var\u0028--sh-token-string\u0029","var\u0028--sh-token-punctuation-section\u0029","var\u0028--sh-token-punctuation\u0029"]},"children":["  ","puts"," ","\"","Status: ","#{","e",".","http_status","}",", Code: ","#{","e",".","code","}",", Message: ","#{","e",".","message","}",", Request ID: ","#{","e",".","request_id","}","\""]},{"\u0024\u0024mdtype":"Tag","name":"CodeLine","attributes":{"tokens":["var\u0028--sh-token-keyword\u0029","var\u0028--sh-color-foreground\u0029","var\u0028--sh-token-punctuation\u0029","var\u0028--sh-color-foreground\u0029"]},"children":["rescue"," ","=\u003E"," e"]},{"\u0024\u0024mdtype":"Tag","name":"CodeLine","attributes":{"tokens":["var\u0028--sh-token-punctuation\u0029","var\u0028--sh-color-comment\u0029"]},"children":["  ","# Something else happened, completely unrelated to Stripe"]},{"\u0024\u0024mdtype":"Tag","name":"CodeLine","attributes":{"tokens":["var\u0028--sh-token-keyword\u0029"]},"children":["end"]}]}]},{"\u0024\u0024mdtype":"Tag","name":"ApirefCodeTab","attributes":{"id":"cli"},"children":[{"\u0024\u0024mdtype":"Tag","name":"Fence","attributes":{"copyable":true,"plaintext":"# Select a client library to see examples of\n# handling different kinds of errors.","language":"sh","numbered":true},"children":[{"\u0024\u0024mdtype":"Tag","name":"CodeLine","attributes":{"tokens":["var\u0028--sh-color-comment\u0029"]},"children":["# Select a client library to see examples of"]},{"\u0024\u0024mdtype":"Tag","name":"CodeLine","attributes":{"tokens":["var\u0028--sh-color-comment\u0029"]},"children":["# handling different kinds of errors."]}]}]},{"\u0024\u0024mdtype":"Tag","name":"ApirefCodeTab","attributes":{"id":"python"},"children":[{"\u0024\u0024mdtype":"Tag","name":"Fence","attributes":{"copyable":true,"plaintext":"try:\n  # Use Stripe's library to make requests...\n  pass\nexcept stripe.error.CardError as e:\n  # A declined card error\n  print\u0028'Status: %s' % e.http_status\u0029\n  print\u0028'Code: %s' % e.code\u0029\n  if e.param:\n    print\u0028'Param: %s' % e.param\u0029\n  print\u0028'Message: %s' % e.user_message\u0029\n  print\u0028'Request ID: %s' % e.request_id\u0029\nexcept stripe.error.RateLimitError as e:\n  # Too many requests made to the API too quickly\n  print\u0028'Request ID: %s' % e.request_id\u0029\nexcept stripe.error.InvalidRequestError as e:\n  # Invalid parameters were supplied to Stripe's API\n  print\u0028'Message: %s' % e.user_message\u0029\n  if e.param:\n    print\u0028'Param: %s' % e.param\u0029\n  print\u0028'Request ID: %s' % e.request_id\u0029\nexcept stripe.error.AuthenticationError as e:\n  # Authentication with Stripe's API failed\n  print\u0028'Request ID: %s' % e.request_id\u0029\nexcept stripe.error.APIConnectionError as e:\n  # Network communication with Stripe failed\n  print\u0028'Request ID: %s' % e.request_id\u0029\nexcept stripe.error.StripeError as e:\n  # All other Stripe errors\n  print\u0028'Status: %s' % e.http_status\u0029\n  print\u0028'Code: %s' % e.code\u0029\n  print\u0028'Message: %s' % e.user_message\u0029\n  print\u0028'Request ID: %s' % e.request_id\u0029\nexcept Exception as e:\n  # Something else happened, completely unrelated to Stripe\n  pass","language":"python","numbered":true},"children":[{"\u0024\u0024mdtype":"Tag","name":"CodeLine","attributes":{"tokens":["var\u0028--sh-token-keyword\u0029","var\u0028--sh-token-punctuation\u0029"]},"children":["try",":"]},{"\u0024\u0024mdtype":"Tag","name":"CodeLine","attributes":{"tokens":["var\u0028--sh-color-foreground\u0029","var\u0028--sh-color-comment\u0029"]},"children":["  ","# Use Stripe's library to make requests..."]},{"\u0024\u0024mdtype":"Tag","name":"CodeLine","attributes":{"tokens":["var\u0028--sh-color-foreground\u0029","var\u0028--sh-token-keyword\u0029"]},"children":["  ","pass"]},{"\u0024\u0024mdtype":"Tag","name":"CodeLine","attributes":{"tokens":["var\u0028--sh-token-keyword\u0029","var\u0028--sh-color-foreground\u0029","var\u0028--sh-token-punctuation\u0029","var\u0028--sh-color-foreground\u0029","var\u0028--sh-token-punctuation\u0029","var\u0028--sh-color-foreground\u0029","var\u0028--sh-token-keyword\u0029","var\u0028--sh-color-foreground\u0029","var\u0028--sh-token-punctuation\u0029"]},"children":["except"," stripe",".","error",".","CardError ","as"," e",":"]},{"\u0024\u0024mdtype":"Tag","name":"CodeLine","attributes":{"tokens":["var\u0028--sh-color-foreground\u0029","var\u0028--sh-color-comment\u0029"]},"children":["  ","# A declined card error"]},{"\u0024\u0024mdtype":"Tag","name":"CodeLine","attributes":{"tokens":["var\u0028--sh-color-foreground\u0029","var\u0028--sh-token-function\u0029","var\u0028--sh-token-punctuation\u0029","var\u0028--sh-token-punctuation\u0029","var\u0028--sh-token-string\u0029","var\u0028--sh-token-constant-char\u0029","var\u0028--sh-token-punctuation\u0029","var\u0028--sh-color-foreground\u0029","var\u0028--sh-token-keyword\u0029","var\u0028--sh-color-foreground\u0029","var\u0028--sh-token-punctuation