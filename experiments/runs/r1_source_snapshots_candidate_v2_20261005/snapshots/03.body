"children":[{"\u0024\u0024mdtype":"Tag","name":"Fence","attributes":{"copyable":true,"plaintext":"try {\n  \u002F\u002F Use Stripe's library to make request\n} catch \u0028StripeException e\u0029 {\n  switch \u0028e.StripeError.Type\u0029\n  {\n    case \"card_error\":\n      \u002F\u002F A declined card error\n      Console.WriteLine\u0028\"Status: \" \u002B \u0028int\u0029e.HttpStatusCode\u0029;\n      Console.WriteLine\u0028\"Code: \" \u002B e.StripeError.Code\u0029;\n      if \u0028e.StripeError.DeclineCode \u0021= null\u0029\n        Console.WriteLine\u0028\"Decline code: \" \u002B e.StripeError.DeclineCode\u0029;\n      if \u0028e.StripeError.Param \u0021= null\u0029\n        Console.WriteLine\u0028\"Param: \" \u002B e.StripeError.Param\u0029;\n      Console.WriteLine\u0028\"Message: \" \u002B e.StripeError.Message\u0029;\n      Console.WriteLine\u0028\"Request ID: \" \u002B e.StripeError.RequestId\u0029;\n      break;\n    case \"api_connection_error\":\n      \u002F\u002F Network communication with Stripe failed\n      break;\n    case \"api_error\":\n      \u002F\u002F An error occurred internally with Stripe's API\n      break;\n    case \"authentication_error\":\n      \u002F\u002F Authentication with Stripe's API failed\n      break;\n    case \"invalid_request_error\":\n      \u002F\u002F Invalid parameters were supplied to Stripe's API\n      Console.WriteLine\u0028\"Message: \" \u002B e.StripeError.Message\u0029;\n      if \u0028e.StripeError.Param \u0021= null\u0029\n        Console.WriteLine\u0028\"Param: \" \u002B e.StripeError.Param\u0029;\n      break;\n    case \"rate_limit_error\":\n      \u002F\u002F Too many requests made to the API too quickly\n      break;\n    case \"validation_error\":\n      break;\n    default:\n      \u002F\u002F All other Stripe errors\n      Console.WriteLine\u0028\"Status: \" \u002B \u0028int\u0029e.HttpStatusCode\u0029;\n      Console.WriteLine\u0028\"Code: \" \u002B e.StripeError?.Code\u0029;\n      Console.WriteLine\u0028\"Message: \" \u002B e.StripeError?.Message\u0029;\n      Console.WriteLine\u0028\"Type: \" \u002B e.StripeError?.Type\u0029;\n      break;\n  }\n}","language":"dotnet","numbered":true},"children":[{"\u0024\u0024mdtype":"Tag","name":"CodeLine","attributes":{"tokens":["var\u0028--sh-token-keyword\u0029","var\u0028--sh-color-foreground\u0029","var\u0028--sh-token-punctuation\u0029"]},"children":["try"," ","{"]},{"\u0024\u0024mdtype":"Tag","name":"CodeLine","attributes":{"tokens":["var\u0028--sh-token-punctuation\u0029","var\u0028--sh-color-comment\u0029"]},"children":["  ","\u002F\u002F Use Stripe's library to make request"]},{"\u0024\u0024mdtype":"Tag","name":"CodeLine","attributes":{"tokens":["var\u0028--sh-token-punctuation\u0029","var\u0028--sh-color-foreground\u0029","var\u0028--sh-token-keyword\u0029","var\u0028--sh-color-foreground\u0029","var\u0028--sh-token-punctuation\u0029","var\u0028--sh-color-foreground\u0029","var\u0028--sh-token-punctuation\u0029","var\u0028--sh-color-foreground\u0029","var\u0028--sh-token-punctuation\u0029"]},"children":["}"," ","catch"," ","\u0028","StripeException e","\u0029"," ","{"]},{"\u0024\u0024mdtype":"Tag","name":"CodeLine","attributes":{"tokens":["var\u0028--sh-color-foreground\u0029","var\u0028--sh-token-keyword\u0029","var\u0028--sh-color-foreground\u0029","var\u0028--sh-token-punctuation\u0029","var\u0028--sh-token-variable\u0029","var\u0028--sh-token-punctuation\u0029","var\u0028--sh-token-variable\u0029","var\u0028--sh-token-punctuation\u0029","var\u0028--sh-token-variable\u0029","var\u0028--sh-token-punctuation\u0029"]},"children":["  ","switch"," ","\u0028","e",".","StripeError",".","Type","\u0029"]},{"\u0024\u0024mdtype":"Tag","name":"CodeLine","attributes":{"tokens":["var\u0028--sh-color-foreground\u0029","var\u0028--sh-token-punctuation\u0029"]},"children":["  ","{"]},{"\u0024\u0024mdtype":"Tag","name":"CodeLine","attributes":{"tokens":["var\u0028--sh-color-foreground\u0029","var\u0028--sh-token-keyword\u00