24mdtype":"Tag","name":"Link","attributes":{"href":"https:\u002F\u002Fdashboard.stripe.com\u002Fworkbench"},"children":["Workbench"]},"\u0029. Create a webhook endpoint with an API version equal to the version that’s pinned by your version of ",{"\u0024\u0024mdtype":"Tag","name":"InlineCode","attributes":{"content":"stripe-dotnet","\u0024\u0024markdoc:type":"node"},"children":[]},", which you can determine through the ",{"\u0024\u0024mdtype":"Tag","name":"InlineCode","attributes":{"content":"StripeConfiguration.ApiVersion","\u0024\u0024markdoc:type":"node"},"children":[]}," property."]}]},{"\u0024\u0024mdtype":"Tag","name":"Paragraph","attributes":{},"children":["You can upgrade your API version in ",{"\u0024\u0024mdtype":"Tag","name":"Link","attributes":{"href":"https:\u002F\u002Fdashboard.stripe.com\u002Fworkbench"},"children":["Workbench"]},". As a precaution, use API versioning to test a new API version before committing to an upgrade."]},{"\u0024\u0024mdtype":"Tag","name":"ApiSectionCsat","attributes":{},"children":[]}]},{"\u0024\u0024mdtype":"Tag","name":"ApiSection","attributes":{"route":"\u002Fapi\u002Fenums","title":"Enums","badges":[],"anchor":"enums","redirects":[],"v2":false},"children":[{"\u0024\u0024mdtype":"Tag","name":"Paragraph","attributes":{},"children":["Some properties on API resources use a fixed set of possible string values, which are known as enums. Enums can be ",{"\u0024\u0024mdtype":"Tag","name":"em","attributes":{},"children":["closed"]}," or ",{"\u0024\u0024mdtype":"Tag","name":"em","attributes":{},"children":["open"]},":"]},{"\u0024\u0024mdtype":"Tag","name":"List","attributes":{"ordered":false},"children":[{"\u0024\u0024mdtype":"Tag","name":"li","attributes":{},"children":[{"\u0024\u0024mdtype":"Tag","name":"strong","attributes":{},"children":["Closed"]},": The set of values for the enum is fixed and won’t grow or change over time."]},{"\u0024\u0024mdtype":"Tag","name":"li","attributes":{},"children":[{"\u0024\u0024mdtype":"Tag","name":"strong","attributes":{},"children":["Open"]},": The set of values for the enum can grow or change over time. Stripe can add new values as a backward-compatible change without requiring an ",{"\u0024\u0024mdtype":"Tag","name":"Link","attributes":{"href":"\u002Fapi\u002Fversioning"},"children":["API version"]}," upgrade. Each enum’s reference entry indicates whether it is open."]}]},{"\u0024\u0024mdtype":"Tag","name":"Heading","attributes":{"level":2},"children":["Handling open enums in responses"]},{"\u0024\u0024mdtype":"Tag","name":"Paragraph","attributes":{},"children":["Don’t assume that the values documented for an open enum are exhaustive. When you read an open enum from an API response, your code should include a safe fallback—such as a default branch in a switch statement—to gracefully handle values your integration doesn’t yet recognize."]},{"\u0024\u0024mdtype":"Tag","name":"Heading","attributes":{"level":2},"children":["Sending enum values in requests"]},{"\u0024\u0024mdtype":"Tag","name":"Paragraph","attributes":{},"children":["When sending an enum value in a request, use only the values documented for the parameter you’re setting. Even if an enum is open, Stripe validates request values against the set of values that are currently supported."]},{"\u0024\u0024mdtype":"Tag","name":"ApiSectionCsat","attributes":{},"children":[]}]}]},"shouldRenderPlaceholderToc":false,"urls":["\u002Fapi","\u002Fapi\u002Fauthentication","\u002Fapi\u002Ferrors","\u002Fapi\u002Ferrors\u002Fhandling","\u002Fapi\u002Fexpanding_objects","\u002Fapi\u002Fidempotent_requests","\u002Fapi\u002Finclude_dependent_response_values","\u002Fapi\u002Fmetadata","\u002Fapi\u002Fpagination","\u002Fapi\u002Fpagination\u002Fsearch","\u002Fapi\u002Fpagination\u002Fauto","\u002Fapi\u002Frequest_ids","\u002Fapi\u002Fconnected-accounts","\u002Fapi\u002Fversioning","\u002Fapi\u002Fenums"]},"baseUrl":"https:\u002F\u002Fdocs.stripe.com","baseUrlAssets":"https:\u002F\u002Fb.stripecdn.com\u002Fdocs-stati