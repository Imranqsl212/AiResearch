ebhooks\";\n\nconst webhooks = new Webhooks({\n  secret: process.env.WEBHOOK_SECRET,\n});\n\nconst handleWebhook = async (req, res) =\u003e {\n  const signature = req.headers[\"x-hub-signature-256\"];\n  const body = await req.text();\n\n  if (!(await webhooks.verify(body, signature))) {\n    res.status(401).send(\"Unauthorized\");\n    return;\n  }\n\n  // The rest of your logic here\n};\n"}]}]},{"type":"element","tagName":"pre","properties":{},"children":[{"type":"element","tagName":"code","properties":{"className":["hljs","language-javascript"]},"children":[{"type":"element","tagName":"span","properties":{"className":["hljs-keyword"]},"children":[{"type":"text","value":"import"}]},{"type":"text","value":" { "},{"type":"element","tagName":"span","properties":{"className":["hljs-title","class_"]},"children":[{"type":"text","value":"Webhooks"}]},{"type":"text","value":" } "},{"type":"element","tagName":"span","properties":{"className":["hljs-keyword"]},"children":[{"type":"text","value":"from"}]},{"type":"text","value":" "},{"type":"element","tagName":"span","properties":{"className":["hljs-string"]},"children":[{"type":"text","value":"\"@octokit/webhooks\""}]},{"type":"text","value":";\n\n"},{"type":"element","tagName":"span","properties":{"className":["hljs-keyword"]},"children":[{"type":"text","value":"const"}]},{"type":"text","value":" webhooks = "},{"type":"element","tagName":"span","properties":{"className":["hljs-keyword"]},"children":[{"type":"text","value":"new"}]},{"type":"text","value":" "},{"type":"element","tagName":"span","properties":{"className":["hljs-title","class_"]},"children":[{"type":"text","value":"Webhooks"}]},{"type":"text","value":"({\n  "},{"type":"element","tagName":"span","properties":{"className":["hljs-attr"]},"children":[{"type":"text","value":"secret"}]},{"type":"text","value":": process."},{"type":"element","tagName":"span","properties":{"className":["hljs-property"]},"children":[{"type":"text","value":"env"}]},{"type":"text","value