        <span>
            <a href="javascript:toggleblocksOC('190_Likelihood_Of_Exploit');"><img id="ocimg_190_Likelihood_Of_Exploit" src="/images/head_more.gif" border="0" alt="+"></a>
        </span>Likelihood Of Exploit
    </div>
    <div name="oc_190_Likelihood_Of_Exploit" id="oc_190_Likelihood_Of_Exploit" class="expandblock">
        <div class="detail">
            <div class="indent">Medium</div>
        </div>
