{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://when-to-stop-bench.org/schema/experiment-manifest-0.1.0.json",
  "title": "When to Stop experiment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "model",
    "agent_version",
    "benchmark_version",
    "task_ids",
    "task_count",
    "runs_per_task",
    "temperature",
    "max_steps",
    "timeout_seconds",
    "git_commit",
    "adapter_type",
    "sandbox_type",
    "safety_mode",
    "seed",
    "token_budget",
    "notes",
    "created_at",
    "date"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "experiment_id": {"type": "string"},
    "model": {"type": "string"},
    "agent_version": {"type": "string"},
    "benchmark_version": {"type": "string"},
    "task_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "task_count": {"type": "integer", "minimum": 1},
    "runs_per_task": {"type": "integer", "minimum": 1},
    "temperature": {"type": ["number", "null"]},
    "max_steps": {"type": "integer", "minimum": 1},
    "timeout_seconds": {"type": "integer", "minimum": 1},
    "git_commit": {"type": "string"},
    "adapter_type": {"type": "string"},
    "sandbox_type": {"type": "string"},
    "safety_mode": {"type": "string"},
    "seed": {"type": ["integer", "null"], "minimum": 0},
    "token_budget": {"type": ["integer", "null"], "minimum": 0},
    "notes": {"type": "string"},
    "created_at": {"type": "string"},
    "date": {"type": "string"}
  }
}
