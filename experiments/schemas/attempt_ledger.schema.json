{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Finalized all-attempt episode ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment_id", "schedule_sha256", "slots"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "experiment_id": {"type": "string", "minLength": 1},
    "schedule_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "slots": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["slot_id", "status", "attempts", "selected_run_id", "missing_reason"],
        "properties": {
          "slot_id": {"type": "string"},
          "status": {"enum": ["RECORDED", "MISSING"]},
          "attempts": {
            "type": "array", "maxItems": 3,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["run_id", "classification"],
              "properties": {
                "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
                "classification": {"enum": ["SETUP_FAILURE", "SELECTED"]}
              }
            }
          },
          "selected_run_id": {"type": ["string", "null"]},
          "missing_reason": {"enum": [null, "NOT_STARTED", "SAFETY_HALT", "RESOURCE_LIMIT", "SETUP_FAILURES_EXHAUSTED", "OTHER_DECLARED"]}
        }
      }
    }
  }
}
