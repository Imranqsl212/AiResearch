{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://when-to-stop-bench.org/schema/observable-trajectory-event-0.1.0.json",
  "title": "Observable trajectory event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "experiment_id",
    "run_id",
    "public_run_id",
    "task_id",
    "public_task_id",
    "condition",
    "model",
    "agent_version",
    "timestamp",
    "step",
    "tool",
    "action",
    "raw_action",
    "parameters",
    "observation",
    "outcome",
    "strategy",
    "adaptation",
    "previous_state",
    "next_state",
    "verifier_result",
    "stop_event",
    "runtime",
    "errors",
    "environment_state",
    "available_budget",
    "benchmark_version",
    "git_commit",
    "token_usage"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "event_id": {"type": "string"},
    "event_type": {"type": "string"},
    "experiment_id": {"type": "string"},
    "run_id": {"type": "string"},
    "public_run_id": {"type": "string"},
    "task_id": {"type": "string"},
    "public_task_id": {"type": "string"},
    "condition": {"type": "string"},
    "model": {"type": "string"},
    "agent_version": {"type": "string"},
    "timestamp": {"type": "string"},
    "step": {"type": "integer", "minimum": 0},
    "tool": {"type": ["string", "null"]},
    "action": {"type": ["object", "null"]},
    "raw_action": {"type": ["object", "null"]},
    "parameters": {"type": "object"},
    "observation": {"type": ["object", "null"]},
    "outcome": {"type": ["string", "null"]},
    "strategy": {"type": ["object", "null"]},
    "adaptation": {"type": ["object", "null"]},
    "previous_state": {"type": ["string", "null"]},
    "next_state": {"type": ["string", "null"]},
    "verifier_result": {"type": ["object", "null"]},
    "stop_event": {"type": ["string", "null"]},
    "runtime": {"type": "object"},
    "errors": {"type": "array"},
    "environment_state": {"type": "object"},
    "available_budget": {"type": "object"},
    "benchmark_version": {"type": "string"},
    "git_commit": {"type": "string"},
    "token_usage": {"type": ["object", "null"]}
  }
}
